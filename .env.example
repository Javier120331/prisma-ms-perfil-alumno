PORT=3005
CORS_ORIGIN=http://localhost:3002,http://127.0.0.1:3002
# Desactivar CORS en producción cuando API Gateway maneja CORS
ENABLE_CORS=true

DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Cognito JWKS — solo para validar JWT (jose)
# Los microservicios NO deben tener COGNITO_CLIENT_ID ni secretos.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
